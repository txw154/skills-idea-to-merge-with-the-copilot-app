---
// Markup renders during the static build. All dynamic behavior and browser
// storage access lives in the client <script> below, which Astro runs only in
// the browser, so the build never touches localStorage.
---
<form id="add-bookmark" novalidate>
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p id="form-error" class="error" role="alert" hidden></p>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite"></ul>

<script>
  import {
    SEPARATOR,
    loadBookmarks,
    normalizeUrl,
    saveBookmarks,
    uniqueSlug,
    type Bookmark,
  } from '../lib/bookmarks';

  const form = document.getElementById('add-bookmark') as HTMLFormElement | null;
  const input = document.getElementById('url') as HTMLInputElement | null;
  const errorEl = document.getElementById('form-error');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const list = document.getElementById('bookmark-list');
  const clearAll = document.getElementById('clear-all');

  let bookmarks: Bookmark[] = [];

  function showError(message: string) {
    if (!errorEl) return;
    errorEl.textContent = message;
    errorEl.hidden = !message;
  }

  function persist() {
    try {
      if (!saveBookmarks(window.localStorage, bookmarks)) {
        showError('Could not save to this browser; bookmarks may not persist.');
      }
    } catch {
      showError('Could not save to this browser; bookmarks may not persist.');
    }
  }

  function render() {
    if (!list) return;
    list.replaceChildren();
    for (const b of bookmarks) {
      const li = document.createElement('li');
      li.className = 'bookmark';

      const text = document.createElement('span');
      text.className = 'entry';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = b.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = b.url;

      const sep = document.createElement('span');
      sep.className = 'sep';
      sep.textContent = SEPARATOR;

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = b.slug;

      text.append(link, sep, slug);

      const copy = document.createElement('button');
      copy.type = 'button';
      copy.className = 'copy';
      copy.textContent = 'Copy';
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(b.slug);
          copy.textContent = 'Copied!';
          setTimeout(() => (copy.textContent = 'Copy'), 1200);
        } catch {
          copy.textContent = 'Copy failed';
        }
      });

      li.append(text, copy);
      list.append(li);
    }
    const has = bookmarks.length > 0;
    if (emptyState) emptyState.hidden = has;
    if (listHeader) listHeader.hidden = !has;
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault(); // must stay first: prevents a native submit reload
    try {
      const url = normalizeUrl(input?.value);
      if (!url) {
        showError('Please enter a valid web address, like example.com.');
        return;
      }
      showError('');
      if (bookmarks.some((b) => b.url === url)) {
        showError('That link is already saved.');
        return;
      }
      bookmarks = [{ url, slug: uniqueSlug(bookmarks) }, ...bookmarks];
      persist();
      render();
      if (input) input.value = '';
    } catch {
      showError('Something went wrong adding that link. Please try again.');
    }
  });

  clearAll?.addEventListener('click', () => {
    try {
      if (!window.confirm('Remove all saved bookmarks?')) return;
      bookmarks = [];
      persist();
      render();
    } catch {
      showError('Could not clear bookmarks.');
    }
  });

  try {
    bookmarks = loadBookmarks(window.localStorage);
  } catch {
    bookmarks = [];
  }
  render();
</script>
